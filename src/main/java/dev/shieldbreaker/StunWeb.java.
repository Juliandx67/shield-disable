package dev.shieldbreaker;

import net.fabricmc.api.ClientModInitializer;
import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents;
import net.minecraft.block.Blocks;
import net.minecraft.client.MinecraftClient;
import net.minecraft.client.network.ClientPlayerEntity;
import net.minecraft.entity.player.PlayerEntity;
import net.minecraft.item.ItemStack;
import net.minecraft.item.Items;
import net.minecraft.registry.tag.ItemTags;
import net.minecraft.util.Hand;
import net.minecraft.util.hit.BlockHitResult;
import net.minecraft.util.math.BlockPos;
import net.minecraft.util.math.Direction;
import net.minecraft.util.math.Vec3d;

public class StunWeb implements ClientModInitializer {
    private static final double MAX_DIST = 3.8;
    private static final double MIN_AIM = 0.85;
    private static final double REACH = 4.5;

    private boolean swapped = false;
    private PlayerEntity locked = null;
    private int timeout = 0;

    @Override
    public void onInitializeClient() {
        ClientTickEvents.END_CLIENT_TICK.register(this::tick);
    }

    private void tick(MinecraftClient mc) {
        ClientPlayerEntity p = mc.player;
        if (p == null || mc.world == null || mc.interactionManager == null || mc.currentScreen != null) return;

        int axe = findSlot(p, true), web = findSlot(p, false);
        if (axe < 0 || web < 0) { reset(); return; }

        if (!swapped) {
            if (!p.getMainHandStack().isIn(ItemTags.SWORDS)) return;
            if (!p.isOnGround() || p.getAttackCooldownProgress(0f) < 0.95f) return;
            PlayerEntity t = findTarget(mc, p);
            if (t == null) return;

            // Attribute Swap: im selben Tick auf Axt wechseln und schlagen
            p.getInventory().setSelectedSlot(axe);
            mc.interactionManager.attackEntity(p, t);
            p.swingHand(Hand.MAIN_HAND);
            swapped = true;
            locked = t;
            timeout = 6;
        } else {
            if (locked == null || !locked.isAlive() || --timeout <= 0) { reset(); return; }

            BlockPos feet = locked.getBlockPos();
            if (mc.world.getBlockState(feet).isOf(Blocks.COBWEB)) { reset(); return; } // sitzt schon

            p.getInventory().setSelectedSlot(web);
            placeWeb(mc, p, feet);
        }
    }

    // Sucht eine feste Fläche neben dem Ziel-Block und setzt das Web hinein
    private void placeWeb(MinecraftClient mc, ClientPlayerEntity p, BlockPos feet) {
        if (!mc.world.getBlockState(feet).isReplaceable()) return; // Block belegt

        for (Direction d : Direction.values()) { // Reihenfolge: unten, oben, Seiten
            BlockPos support = feet.offset(d);
            if (mc.world.getBlockState(support).isReplaceable()) continue; // nichts zum Anklicken
            if (p.getEyePos().distanceTo(Vec3d.ofCenter(support)) > REACH) continue;

            Direction face = d.getOpposite(); // Seite des Support-Blocks, die zum Ziel zeigt
            Vec3d hitPos = Vec3d.ofCenter(support).add(
                    face.getOffsetX() * 0.5, face.getOffsetY() * 0.5, face.getOffsetZ() * 0.5);
            BlockHitResult hit = new BlockHitResult(hitPos, face, support, false);
            mc.interactionManager.interactBlock(p, Hand.MAIN_HAND, hit);
            p.swingHand(Hand.MAIN_HAND);
            return;
        }
    }

    private PlayerEntity findTarget(MinecraftClient mc, ClientPlayerEntity p) {
        Vec3d eye = p.getEyePos();
        Vec3d look = p.getRotationVec(1f);
        PlayerEntity best = null;
        double bestDist = Double.MAX_VALUE;
        for (PlayerEntity o : mc.world.getPlayers()) {
            if (o == p || !o.isBlocking()) continue;
            Vec3d to = o.getBoundingBox().getCenter().subtract(eye);
            double dist = to.length();
            if (dist > MAX_DIST || dist < 0.001) continue;
            if (to.normalize().dotProduct(look) < MIN_AIM) continue;
            if (dist < bestDist) { bestDist = dist; best = o; }
        }
        return best;
    }

    private void reset() { swapped = false; locked = null; timeout = 0; }

    private int findSlot(ClientPlayerEntity p, boolean axe) {
        for (int i = 0; i < 9; i++) {
            ItemStack s = p.getInventory().getStack(i);
            if (axe ? s.isIn(ItemTags.AXES) : s.isOf(Items.COBWEB)) return i;
        }
        return -1;
    }
}
